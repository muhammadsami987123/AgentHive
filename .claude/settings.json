{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run start)",
      "Bash(npm test*)",
      "Bash(npx*)",
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pip install*)",
      "Bash(pip freeze)",
      "Bash(python -m venv*)",
      "Bash(uvicorn*)",
      "Bash(alembic*)",
      "Bash(pytest*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(echo*)",
      "Bash(mkdir*)",
      "Bash(curl*)",
      "Bash(psql*)",
      "Read(*)",
      "Write(frontend/**)",
      "Write(backend/**)",
      "Write(.claude/**)",
      "Write(*.md)",
      "Edit(frontend/**)",
      "Edit(backend/**)",
      "Edit(.claude/**)",
      "Edit(*.md)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/*secret*)",
      "Read(**/*credentials*)"
    ]
  },
  "enabledSkills": [
    "ui-ux-pro-max",
    "frontend-design:frontend-design",
    "claude-api",
    "fetch-library-docs",
    "simplify",
    "less-permission-prompts",
    "code-review:code-review",
    "security-review",
    "stripe:stripe-best-practices",
    "stripe:explain-error",
    "stripe:test-cards",
    "theme-factory",
    "doc-coauthoring",
    "skill-creator",
    "interview"
  ],
  "env": {
    "PROJECT_NAME": "AgentHive",
    "NODE_ENV": "development"
  }
}
